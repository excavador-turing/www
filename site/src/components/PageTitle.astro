---
// Starlight prints the title as the page's H1. Pages whose layout carries
// its own H1 (tp.hideTitle in its front matter) would otherwise have two.
// The anchor stays, because the table of contents and the skip link use it
// ("_top" is Starlight's PAGE_TITLE_ID, which the package does not export).
//
// A news post gets its date under its title (the way back to the list and
// the date again are its sidebar, Sidebar.astro, on a wide screen).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { humanDate, isoDate, NEWS } from '../lib/news';

const { entry } = Astro.locals.starlightRoute;
const hide = entry.data.tp?.hideTitle;
const date = entry.id.startsWith(`${NEWS}/`) ? entry.data.date : undefined;
---

{hide ? <span id="_top"></span> : <Default />}
{
  date && (
    <p class="tp-post__meta tp-post__meta--page">
      <time datetime={isoDate(date)}>{humanDate(date)}</time>
    </p>
  )
}
