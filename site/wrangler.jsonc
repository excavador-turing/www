// The Worker that serves turingpi.xyz: static assets only, no Worker code, no KV, no routes.
// `astro build` writes the site to dist/ (headers from public/_headers included); the Worker
// job of .github/workflows/publish.yaml runs `wrangler deploy` on this file. The repository
// holds no account id and no Cloudflare hostname. The Worker, its custom domains and the DNS
// records are declared outside this repository; a deploy uploads a new version of the Worker
// and changes none of them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turingpi-site",
  // Compatibility date: not newer than two weeks before it was chosen.
  "compatibility_date": "2026-10-15",
  // BOTH OFF, DELIBERATELY. Wrangler's defaults turn them on: every deploy would publish a
  // <worker>.<account-subdomain>.workers.dev hostname, and previews would publish one per
  // version. That hostname names the operator's account, and the pull requests of this
  // repository are public. Pull requests are judged by GitHub CI and by `wrangler dev`.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // A page that does not exist gets the site's own 404.html with status 404.
    // html_handling stays at its default, auto-trailing-slash: the site builds one directory
    // per page (trailingSlash 'always'), so /features/ serves features/index.html and
    // /features redirects to /features/.
    "not_found_handling": "404-page"
  }
}
