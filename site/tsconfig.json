{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // `~/components/macros` from any page, at any depth: the converted pages
    // import their components by this name, so a page can move without its
    // imports breaking.
    "paths": { "~/*": ["./src/*"] }
  }
}
