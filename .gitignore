# Both spellings: `just check` in a worktree wants a venv, and a symlink to
# the main checkout's is the cheap way to get one -- which `.venv/` does not
# match, so it got staged once.
.venv
.venv/
.devbox/
/site/
__pycache__/

# The demo panes are built at deploy from the latest BMC-UI release
# (.github/workflows/publish.yaml); locally, `just demo-fork-latest <checkout>`.
/starlight/public/demo/fork/
/starlight/public/demo/fleet/

# Worktrees live inside the checkout (the standing rule is to branch in one
# rather than disturb the main tree). Without this, `git add -A` records the
# whole worktree as a gitlink.
/worktree/

# The Starlight build (starlight/): what it installs and builds, never its
# sources.
/starlight/node_modules/
/starlight/dist/
/starlight/.astro/
/starlight/.yarn/*
!/starlight/.yarn/releases/
!/starlight/.yarn/plugins/
/starlight/.pnp.*
