# Both spellings: `just check` in a worktree wants a venv, and a symlink to
# the main checkout's is the cheap way to get one -- which `.venv/` does not
# match, so it got staged once.
.venv
.venv/
.devbox/
/site/
__pycache__/

# The fork demo pane is built at deploy from the latest BMC-UI release
# (.github/workflows/pages.yml); locally, `just demo-fork-latest <checkout>`.
docs/demo/fork/
docs/demo/fleet/

# Worktrees live inside the checkout (the standing rule is to branch in one
# rather than disturb the main tree). Without this, `git add -A` records the
# whole worktree as a gitlink.
/worktree/

# The Starlight build (starlight/). Its content, public files and generated
# data are rendered from docs/ by scripts/mkdocs-to-starlight.py before every
# build -- MkDocs is the source of truth until the switch -- so none of it is
# committed. Only the build's own sources are.
/starlight/node_modules/
/starlight/dist/
/starlight/.astro/
/starlight/.yarn/*
!/starlight/.yarn/releases/
!/starlight/.yarn/plugins/
/starlight/.pnp.*
/starlight/src/content/docs/
/starlight/src/generated/
/starlight/public/
